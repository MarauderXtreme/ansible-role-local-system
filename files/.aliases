alias clip-key="cs ~/.ssh/id_ed25519.pub"

# learn host_keys
alias learn-host-keys='ssh -o "HostKeyAlgorithms ecdsa-sha2-nistp256-cert-v01@openssh.com,ssh-ed25519-cert-v01@openssh.com,ssh-rsa-cert-v01@openssh.com,ecdsa-sha2-nistp256,ssh-ed25519,ssh-rsa,ecdsa-sha2-nistp521-cert-v01@openssh.com,ecdsa-sha2-nistp384-cert-v01@openssh.com,ecdsa-sha2-nistp521,ecdsa-sha2-nistp384" -o "UpdateHostKeys ask"'

# short-hand for setting up commit author information
alias git-real-name='git config user.name "Christoph Kepler"'

# Functions section
git-config() {
	case $1 in
		ag)
			EMAIL="chriske@wh12.tu-dresden.de";;
		private)
			EMAIL="development@kepler.international";;
		work)
			EMAIL="christoph.kepler@tyclipso.net";;
		*)
			echo "Currently supports ag, private and work";;
	esac
	git-real-name
	git config user.email "$EMAIL"
}

# function for editing currently read-only files
ro-edit() {
	for F in "$@"; do
		if [ -f "$F" ]; then
			chmod u+w "$F"
			edit "$F"
			chmod u-w "$F"
		fi
	done
}

# new version of myip with curl and nice things
myip() {
	if [[ -z "$1" ]]; then
		curl -sSfL --retry 3 -w '\n' --url https://diagnostic.opendns.com/myip
	elif [[ "$1" -eq 4 ]]; then
		curl -sSfL --retry 3 -w '\n' --url https://v4.ident.me/
	elif [[ "$1" -eq 6 ]]; then
		curl -sSfL --retry 3 -w '\n' --url https://v6.ident.me/
	else
		\cat << _EOF_
This function shows the current public_ip of the host. Curls either opendns as
endpoint or (v4|v6).indent.me for more stable output of the wanted info.
Usage:
myip                … query diagnotic.opendns.com/myip
myip [-h|--help|*]  … show this message
myip 4              … query v4.ident.me
myip 6              … query v6.ident.me
_EOF_
	fi
}

# remove remains from super-linter runs to prevent appending
remove-super-linter-log () {
  if [[ -f "$1/super-linter.log" ]]; then
    echo -n "Remove old super-lint.log [Y|n|append]: "
    read -r ANSWER
    case "$ANSWER" in
      n|no|N|No|NO|nein|Nein|NEIN)
        echo "exiting now"
        exit 0;;
      a|append|A|Append|APPEND)
        echo "appending to the old logfile";;
      ''|y|Y|yes|Yes|YES|j|J|ja|Ja|JA)
        rm -f "$1/super-linter.log";;
      *)
        echo "Not recognized input. Exiting now."
        exit 1;;
    esac
  fi
}

# run github/super-linter container anywhere or with any path
super-lint () {
  if [[ -z "$1" ]]; then
    remove-super-linter-log "$(pwd)"
    if [[ -f "$(pwd)/.github/super-linter.env"  ]]; then
      docker run --rm -e RUN_LOCAL=true -e USE_FIND_ALGORITHM=false --env-file "$(pwd)/.github/super-linter.env" -v "$(pwd)":/tmp/lint github/super-linter:slim-latest
    else
      docker run --rm -e RUN_LOCAL=true -e USE_FIND_ALGORITHM=false -v "$(pwd)":/tmp/lint github/super-linter:slim-latest
    fi
  elif [[ -d "$1" ]]; then
    if [[ "$1" = ~* ]] || [[ "$1" = /* ]]; then
      remove-super-linter-log "$1"
      if [[ -f "$1/.github/super-linter.env"  ]]; then
        docker run --rm -e RUN_LOCAL=true -e USE_FIND_ALGORITHM=false --env-file "$1/.github/super-linter.env" -v "$1":/tmp/lint github/super-linter:slim-latest
      else
        docker run --rm -e RUN_LOCAL=true -e USE_FIND_ALGORITHM=false -v "$1":/tmp/lint github/super-linter:slim-latest
      fi
    else
      \cat << _EOF_
Docker does not support relative volume mounts. Either use absolute paths like
/path/to/directory or home paths like ~/path/to/directory.
_EOF_
    fi
  fi
}

remote-sshfp () {
  set -e

  if [[ "$#" -lt 1 ]]; then
    echo "Usage: $0 <hostname or IP address> <port != 22>"
    exit
  fi

  host="$1"
	port="${2:-22}"

  TMPFILE="$(mktemp /var/tmp/sshfp.XXXXXX)"
  trap 'rm -f ${TMPFILE}' INT TERM EXIT

  for proto in rsa ecdsa ed25519; do
    ssh-keyscan -t "$proto" -p "$port" "$host" > ${TMPFILE} 2>/dev/null
    [[ ! -s "${TMPFILE}" ]] && continue
    sed -ri 's/^[^ ]+ //' ${TMPFILE}
    ssh-keygen -r "$host" -f ${TMPFILE}
  done
}

show-colors() {
	if [[ "$SHELL" = *bash ]]; then
		echo "does not work in bash. exiting now"
		exit 1
	fi
	for CODE in {000..255}; do
		print -P -- "$CODE: %F{$CODE}This is how your text would look like%f"
	done
}

